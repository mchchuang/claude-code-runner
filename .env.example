# GitHub Personal Access Token (required)
# Needs repo, read:org, and workflow permissions
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gitea (optional) - enables the repo picker in the dashboard
# Token needs repository read/write plus read:user / read:organization
GITEA_URL=https://git.example.com
GITEA_TOKEN=

# Anthropic API Key (optional)
# If not set, falls back to OAuth token from mounted ~/.claude directory
ANTHROPIC_API_KEY=

# Authentication Settings
# Path to store auth credentials (default: /data/auth.json)
AUTH_FILE=/data/auth.json

# Session secret for cookie signing (optional)
# If not set, one is generated on first start and kept in /data/session-secret, so logins
# (stored in /data/sessions.json) survive restarts and redeploys. Changing it signs everyone out.
SESSION_SECRET=
